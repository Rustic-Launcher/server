@@ -8961,6 +8961,37 @@ impl Game<'_> {
     pub(super) fn native_player_died_v2(&mut self, player: u128, name: &str, message: &Text) {
         mod_api::dispatch_player_died_v2(self, mod_api::mods(), player, name, message);
