+#[test]
+fn a_status_response_is_edited_in_turn_and_unchanged_fields_stay() {
+    use horizon_client::mod_api::{StatusResponseEvent, Text, dispatch_status_response};
+    struct Motd;
+    impl Hooks for Motd {
+        fn status_response(&self, event: &mut StatusResponseEvent<'_>) {
+            assert_eq!(event.motd, "A server");
+            assert_eq!(event.protocol, 777);
+            *event.description = Some(Text::literal(format!("{} (Rustic)", event.motd)));
+            event.max_players = 100;
+            event.sample.retain(|(_, name)| name != "Hidden");
+        }
+    }
+    struct Seen;
+    impl Hooks for Seen {
+        fn status_response(&self, event: &mut StatusResponseEvent<'_>) {
+            // The first mod's changes are seen.
+            assert_eq!(event.max_players, 100);
+            assert_eq!(event.sample.len(), 1);
+            event.sample.push((3, "Guest".to_owned()));
+        }
+    }
+    let mods: Vec<Box<dyn Hooks>> = vec![Box::new(Motd), Box::new(Seen)];
+    let (mut description, mut max, mut online) = (None, 20, 2);
+    let mut sample = vec![(1, "Steve".to_owned()), (2, "Hidden".to_owned())];
+    dispatch_status_response(
+        &mods,
+        "127.0.0.1:50000".parse().unwrap(),
+        777,
+        "A server",
+        &mut description,
+        &mut max,
+        &mut online,
+        &mut sample,
+    );
+    assert_eq!(
+        description.map(|t| t.plain()).as_deref(),
+        Some("A server (Rustic)")
+    );
+    assert_eq!((max, online), (100, 2));
+    assert_eq!(sample, [(1, "Steve".to_owned()), (3, "Guest".to_owned())]);
+}
+
+#[test]
+fn a_death_hook_decides_the_message_and_what_is_kept() {
+    use horizon_client::mod_api::{PlayerDiedV3Event, Text, dispatch_player_died_v3};
+    struct TestHost;
+    impl Host for TestHost {}
+    struct Arena;
+    impl Hooks for Arena {
+        fn player_died_v3(&self, _host: &mut dyn Host, event: &mut PlayerDiedV3Event<'_>) {
+            assert_eq!(event.name, "Steve");
+            *event.message = None;
+            event.keep_inventory = true;
+        }
+    }
+    struct Later;
+    impl Hooks for Later {
+        fn player_died_v3(&self, _host: &mut dyn Host, event: &mut PlayerDiedV3Event<'_>) {
+            assert!(
+                event.message.is_none() && event.keep_inventory,
+                "sees the first mod's say"
+            );
+            event.keep_level = true;
+        }
+    }
+    let mods: Vec<Box<dyn Hooks>> = vec![Box::new(Arena), Box::new(Later)];
+    let mut message = Some(Text::literal("Steve fell from a high place"));
+    let (mut keep_inventory, mut keep_level) = (false, false);
+    dispatch_player_died_v3(
+        &mut TestHost,
+        &mods,
+        7,
+        "Steve",
+        &mut message,
+        &mut keep_inventory,
+        &mut keep_level,
+    );
+    assert_eq!(message, None);
+    assert!(keep_inventory && keep_level);
+}
