+    /// `player` (`name`) died: what the death says and keeps, decided by the
+    /// mods (Bukkit's `PlayerDeathEvent`: `deathMessage`, `keepInventory`,
+    /// `keepLevel`). Heard right after `native_player_died_v2`, before
+    /// anything drops. `message` is the line everyone the team lets see it
+    /// gets and the death screen shows, none when death messages are off: set
+    /// it to `None` to send none (the death screen is then empty), or replace
+    /// it. `keep_inventory` starts as the `keep_inventory` rule: true and
+    /// nothing drops, the player keeps every stack; false and they drop as
+    /// with the rule off. `keep_level` starts as the rule (or true for a
+    /// spectator): true and no experience drops and the respawn keeps it;
+    /// false and it drops and is lost. Mods are asked in order and share the
+    /// values. The dying player is not swapped in. Server-side. Pending API
+    /// @API:player_died_v3@.
+    pub(super) fn native_player_died_v3(
+        &mut self,
+        player: u128,
+        name: &str,
+        message: &mut Option<Text>,
+        keep_inventory: &mut bool,
+        keep_level: &mut bool,
+    ) {
+        mod_api::dispatch_player_died_v3(
+            self,
+            mod_api::mods(),
+            player,
+            name,
+            message,
+            keep_inventory,
+            keep_level,
+        );
+    }
