+    /// The sprite a hook draws in the place of the mark before the name of the player `uuid`
+    /// (`horizon_hooks::Hooks::name_picture`), when it is in the atlas (it is then kept this
+    /// frame, as a skin drawn).
+    pub(super) fn hooks_name_picture(&self, uuid: u128) -> Option<u64> {
+        debug_assert!(
+            self.serving.is_none(),
+            "a server thread calls no client hook"
+        );
+        if !engine::any() {
+            return None;
+        }
+        let id = engine::name_picture(uuid)?;
+        HookSprites(self).get(id).map(|_| id)
+    }
