+    #[test]
+    fn a_picture_takes_the_place_of_the_mark_and_the_names_stay_aligned() {
+        const MARK: NameMark = &[(1, 1, 6, 6, 0xFF12_3456)];
+        let font = Font::metrics(std::path::Path::new("missing-tab-test-resources"));
+        let board = Scoreboard::default();
+        // 1 has a mark and a picture, 2 a mark only, 3 neither.
+        let players = [
+            TabPlayer::new(1, "pictured"),
+            TabPlayer::new(2, "marked"),
+            TabPlayer::new(3, "plain"),
+        ];
+        let layout = |picture: &dyn Fn(u128) -> Option<u64>| {
+            TabList::default().layout(
+                &TabInputs {
+                    players: &players,
+                    board: &board,
+                    objective: None,
+                    screen_width: 400,
+                    online_mode: true,
+                    gui_ticks: 0,
+                    background: 0x20ff_ffff,
+                    upside_down: &|_| false,
+                    mark: &|id| (id <= 2).then_some(MARK),
+                    picture,
+                },
+                &font,
+            )
+        };
+        let draws = layout(&|id| (id == 1).then_some(0x2a));
+        let text_x = |name: &str| {
+            draws.iter().find_map(|d| match d {
+                GuiDraw::Text { text, x, .. } if text.plain() == name => Some(*x),
+                _ => None,
+            })
+        };
+        let pictures: Vec<_> = draws
+            .iter()
+            .filter_map(|d| match d {
+                GuiDraw::Blit {
+                    texture,
+                    x,
+                    y,
+                    w,
+                    h,
+                    color,
+                    ..
+                } if texture.starts_with("hooks/") => {
+                    Some((texture.to_string(), *x, *y, *w, *h, *color))
+                }
+                _ => None,
+            })
+            .collect();
+        let marks = draws
+            .iter()
+            .filter(|d| {
+                matches!(
+                    d,
+                    GuiDraw::Fill {
+                        color: 0xFF12_3456,
+                        ..
+                    }
+                )
+            })
+            .count();
+        // One mark (player 2's), and player 1's picture with its shadow under it, a pixel off.
+        assert_eq!(marks, 1);
+        assert_eq!(pictures.len(), 2);
+        let (shadow, picture) = (&pictures[0], &pictures[1]);
+        assert_eq!(picture.0, "hooks/2a");
+        assert_eq!((picture.3, picture.4, picture.5), (8, 8, WHITE));
+        assert_eq!((shadow.1, shadow.2), (picture.1 + 1, picture.2 + 1));
+        assert_eq!(shadow.5, PICTURE_SHADOW);
+        // The picture sits where the mark goes: after the head, a pixel before the name.
+        let pictured = text_x("pictured").unwrap();
+        assert_eq!(picture.1, pictured - 9);
+        assert_eq!(text_x("marked"), Some(pictured));
+        assert_eq!(text_x("plain"), Some(pictured));
+        // Without pictures, both marks again; with neither, no column.
+        let draws = layout(&|_| None);
+        let marks = draws
+            .iter()
+            .filter(|d| {
+                matches!(
+                    d,
+                    GuiDraw::Fill {
+                        color: 0xFF12_3456,
+                        ..
+                    }
+                )
+            })
+            .count();
+        assert_eq!(marks, 2);
+        assert_eq!(hook_sprite(u64::MAX), "hooks/ffffffffffffffff");
+    }
