+    /// A join line a mod chose (`Hub::join_lines`, `native_player_join_message`) replaces
+    /// vanilla's, or hides it; the player still gets their list entry.
+    #[test]
+    fn a_join_line_a_mod_chose_replaces_or_hides_the_vanilla_one() {
+        let mut hub = hub();
+        let (mut watcher, seen) = guest(1, 1, "Watcher");
+        watcher.placed = true;
+        hub.guests.push(watcher);
+        let (hidden, _a) = guest(2, 2, "Quiet");
+        hub.guests.push(hidden);
+        hub.join_lines.insert(2, None);
+        place(&mut hub, 2);
+        let told = ids(&seen);
+        assert!(!told.contains(&id::SYSTEM_CHAT), "{told:?}");
+        assert!(told.contains(&id::PLAYER_INFO_UPDATE), "{told:?}");
+        let (greeted, _b) = guest(3, 3, "Loud");
+        hub.guests.push(greeted);
+        let line = crate::scoreboard::component_tag(&serde_json::json!({"text": "Welcome, Loud"}));
+        hub.join_lines.insert(3, Some(line));
+        place(&mut hub, 3);
+        let chat: Vec<_> = packets(&seen)
+            .into_iter()
+            .filter(|(id, _)| *id == id::SYSTEM_CHAT)
+            .collect();
+        assert_eq!(chat.len(), 1);
+        assert!(
+            chat[0].1.windows(13).any(|w| w == b"Welcome, Loud"),
+            "the mod's line is sent"
+        );
+        assert!(hub.join_lines.is_empty(), "each chosen line is taken once");
+    }
+
     /// A player the proxy announced is held: it gets the whole join sequence,
     /// and the player already there is told nothing at all.
     #[test]
@@ -1979,6 +2011,21 @@ mod hub_tests {
         assert!(ids(&seen).contains(&id::SYSTEM_CHAT));
     }
 
+    /// While mods are loaded the hub holds the leave line back, with whom it goes to, for the game
+    /// to send once the mods have seen it (`native_player_leave_message`).
+    #[test]
+    fn while_mods_are_loaded_the_leave_line_waits_for_the_game() {
+        let (mut hub, seen, _mine, h) = frozen_with_a_watcher();
+        hub.mods_loaded = true;
+        super::release_request(&mut hub, &format!("{UUID} {h} moved announce"));
+        assert!(!ids(&seen).contains(&id::SYSTEM_CHAT), "held back");
+        let mut left = left_events(&mut hub);
+        let (line, told) = left[0].leave_line.take().expect("the held line");
+        assert_eq!(told, [1]);
+        hub.send_system_line(&told, line);
+        assert_eq!(ids(&seen), [id::SYSTEM_CHAT]);
+    }
