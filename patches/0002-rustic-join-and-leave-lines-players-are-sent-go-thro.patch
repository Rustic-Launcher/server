+/// A system line the hub built (`shown`, a component) as a mod sees it: the English text of `key`
+/// with `args` for `Text::plain`, and the exact component for the players.
+fn system_line_text(shown: &horizon_world::nbt::Tag, key: &str, args: &[Text]) -> Text {
+    let component =
+        serde_json::from_str(&horizon_client::lan::conn::component_json(shown)).unwrap_or_default();
+    Text::translate(key, args)
+        .with_color(horizon_client::text::YELLOW)
+        .with_component(component)
+}
