@@ -0,0 +1,94 @@
+//! The main title for trait mods that draw it themselves: hiding its own widgets
+//! (`native_title_widgets_hidden`) and pressing its buttons for the player
+//! (`native_title_open`). API @API:title_screen@.
+use super::{Game, Screen};
+use horizon_client::title::{Action, MainButton, Mode};
+
+/// Whether `button` can be pressed: the main title is the screen on top (no
+/// Options, connect or load over it) and the button is on (Multiplayer and
+/// Realms are off for an account that may not play online).
+fn pressable(main_on_top: bool, allows_multiplayer: bool, button: MainButton) -> bool {
+    main_on_top
+        && (allows_multiplayer || !matches!(button, MainButton::Multiplayer | MainButton::Realms))
+}
+
+impl Game<'_> {
+    /// The main title (`Mode::Main`) is the screen the player sees.
+    fn title_main_on_top(&self) -> bool {
+        self.screen == Screen::Playing
+            && self.screen_hooks_open()
+            && self
+                .title
+                .as_ref()
+                .is_some_and(|t| matches!(t.mode, Mode::Main))
+    }
+    /// Hides (true) or shows again (false) the main title's own widgets — the
+    /// logo, the splash, its buttons, the version line and the bottom notice —
+    /// for a mod that draws its own main menu over the panorama in
+    /// `native_screen_render_post` (screen id `title`) and presses the title's
+    /// buttons with `native_title_open`. Hidden, the main title's buttons take
+    /// no click, Tab or Enter either; every other title screen (world list,
+    /// multiplayer, realms...) is unchanged. It holds for this window until
+    /// changed, through every return to the title, and takes effect from the
+    /// next frame. Client only. API @API:title_screen@.
+    pub(super) fn native_title_widgets_hidden(&self, hidden: bool) {
+        self.title_widgets_hidden.set(hidden);
+    }
+    /// Presses one of the main title's buttons for the player, exactly as a
+    /// click on it: `singleplayer`, `multiplayer`, `realms`, `friends` (Join a
+    /// Friend), `options`, `language`, `accessibility`, `credits` (the bottom
+    /// notice) or `quit`, with the button's sound. The press runs once the
+    /// hooks of this event are done, before the next frame; a later call in the
+    /// same event replaces it. True when it will run: false for another name,
+    /// while the main title is not the screen shown (a world, Options or another
+    /// title screen is), and for `multiplayer` and `realms` when the account
+    /// may not play online (their buttons are off). Works whether the title's
+    /// own widgets are hidden or not. Client only. API @API:title_screen@.
+    pub(super) fn native_title_open(&self, button: &str) -> bool {
+        let Some(button) = MainButton::parse(button) else {
+            return false;
+        };
+        let allows = self.title.as_ref().is_some_and(|t| t.allows_multiplayer);
+        if !pressable(self.title_main_on_top(), allows, button) {
+            return false;
+        }
+        self.title_open_request.set(Some(button));
+        true
+    }
+    /// The press `native_title_open` asked for, done on the title: the action
+    /// for `title_action` to run, as after a click. None with no press, or
+    /// when the title changed since.
+    pub(super) fn take_title_open_request(&mut self) -> Option<Action> {
+        let button = self.title_open_request.take()?;
+        if !self.title_main_on_top() {
+            return None;
+        }
+        let action = self.title.as_mut()?.press_main(button)?;
+        self.save_title_options();
+        self.audio.play_button_click();
+        Some(action)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_button_is_pressable_only_on_the_main_title_and_when_it_is_on() {
+        for button in [
+            MainButton::Singleplayer,
+            MainButton::Options,
+            MainButton::Quit,
+            MainButton::Friends,
+        ] {
+            assert!(pressable(true, false, button));
+            assert!(!pressable(false, true, button));
+        }
+        for button in [MainButton::Multiplayer, MainButton::Realms] {
+            assert!(pressable(true, true, button));
+            assert!(!pressable(true, false, button));
+            assert!(!pressable(false, true, button));
+        }
+    }
+}
