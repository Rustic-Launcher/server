+/// A button of the main title, as a native mod presses it for the player
+/// (`native_title_open`): exactly what the button does there.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MainButton {
+    Singleplayer,
+    Multiplayer,
+    Realms,
+    /// Horizon's Join a Friend (the friends icon): the invite-code screen.
+    Friends,
+    Options,
+    Language,
+    Accessibility,
+    /// The bottom notice (`PlainTextButton`): Credits & Attribution.
+    Credits,
+    Quit,
+}
+
+impl MainButton {
+    /// The button named `name`: `singleplayer`, `multiplayer`, `realms`,
+    /// `friends`, `options`, `language`, `accessibility`, `credits`, `quit`.
+    pub fn parse(name: &str) -> Option<Self> {
+        Some(match name {
+            "singleplayer" => Self::Singleplayer,
+            "multiplayer" => Self::Multiplayer,
+            "realms" => Self::Realms,
+            "friends" => Self::Friends,
+            "options" => Self::Options,
+            "language" => Self::Language,
+            "accessibility" => Self::Accessibility,
+            "credits" => Self::Credits,
+            "quit" => Self::Quit,
+            _ => return None,
+        })
+    }
+    /// Its id among the main title's buttons (`Title::buttons`); the credits are no button.
+    fn id(self) -> Option<u8> {
+        Some(match self {
+            Self::Singleplayer => 1,
+            Self::Quit => 2,
+            Self::Options => 3,
+            Self::Multiplayer => 4,
+            Self::Friends => 5,
+            Self::Language => 6,
+            Self::Accessibility => 7,
+            Self::Realms => 8,
+            Self::Credits => return None,
+        })
+    }
 }
 pub(crate) struct Button {
     x: f32,
@@ -853,6 +906,7 @@ impl Title {
             confirm_experiments: RefCell::new(None),
             preparing: false,
             reopen_data_packs: false,
+            widgets_hidden: false,
         }
     }
     /// Vanilla bypasses the selector when there are no saves.
@@ -1393,6 +1447,39 @@ impl Title {
             realm: true,
         })
     }
+    /// Whether a native mod draws the main title in place of its own widgets.
+    pub fn widgets_hidden(&self) -> bool {
+        self.widgets_hidden
+    }
+    /// Hides (or shows again) the main title's own widgets: the logo, the splash, the
+    /// buttons, the version line and the bottom notice. Hidden, the main title draws
+    /// nothing over the panorama and its buttons take no click, Tab or Enter; the other
+    /// title screens (world list, multiplayer...) are not affected.
+    pub fn set_widgets_hidden(&mut self, hidden: bool) {
+        if hidden && !self.widgets_hidden && matches!(self.mode, Mode::Main) {
+            self.focused_button = None;
+            self.credits_button.set([0.0; 4]);
+        }
+        self.widgets_hidden = hidden;
+    }
+    /// Presses `button` of the main title for the player, hidden widgets or not: the
+    /// same as a click on it, so the caller runs the returned action as a click's.
+    /// None when the title is not on its main screen, and for Multiplayer and Realms
+    /// while the account may not play online (their buttons are off then).
+    pub fn press_main(&mut self, button: MainButton) -> Option<Action> {
+        if !matches!(self.mode, Mode::Main) {
+            return None;
+        }
+        let Some(id) = button.id() else {
+            return Some(Action::Credits);
+        };
+        if matches!(button, MainButton::Multiplayer | MainButton::Realms)
+            && !self.allows_multiplayer
+        {
+            return None;
+        }
+        Some(self.click_action(0.0, 0.0, (0.0, 0.0), Some(id)))
+    }
     pub fn take_open_request(&mut self) -> Option<String> {
         self.open_request.take()
     }
