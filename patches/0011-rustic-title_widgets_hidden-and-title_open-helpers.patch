+
+    /// A native mod that draws the main title itself hides the title's own
+    /// widgets: nothing is drawn over the panorama and no click, Tab or Enter
+    /// reaches the buttons that are no longer seen. Shown again, they are back.
+    #[test]
+    fn hidden_main_widgets_are_neither_drawn_nor_pressed() {
+        let atlas = HudAtlas::build(Path::new("/nonexistent/horizon-test-resources")).unwrap();
+        let (w, h) = (427.0, 240.0);
+        let (cx, y) = ((w / 2.0f32).floor(), (h / 4.0f32).floor() + 48.0);
+        let mut title = fresh();
+        title.splash = Some("Splash!".into());
+        let mut shown = HudBatch::new([854, 480]);
+        title.draw(&atlas, &mut shown, (0.0, 0.0), false);
+        assert!(!shown.vertices.is_empty());
+        title.set_widgets_hidden(true);
+        let mut batch = HudBatch::new([854, 480]);
+        title.draw(&atlas, &mut batch, (0.0, 0.0), false);
+        assert!(batch.vertices.is_empty());
+        assert!(title.buttons(w, h).is_empty());
+        // Singleplayer, Quit, the language icon and the bottom notice's place.
+        for (x, y) in [
+            (cx, y + 10.0),
+            (cx + 50.0, y + 106.0),
+            (cx, y + 82.0),
+            (w - 5.0, h - 5.0),
+        ] {
+            assert_eq!(title.click(x, y, (w, h)), (Action::None, false));
+            assert!(matches!(title.mode, Mode::Main));
+        }
+        title.tab_dir(false, (w, h));
+        assert_eq!(title.focused_button, None);
+        assert_eq!(title.confirm_key_size((w, h)), (Action::None, false));
+        title.set_widgets_hidden(false);
+        assert_eq!(title.buttons(w, h).len(), 8);
+        assert_eq!(
+            title.click(cx + 50.0, y + 106.0, (w, h)),
+            (Action::Quit, true)
+        );
+    }
+
+    /// `press_main` is the button's own press: the same screen or action as a
+    /// click on it, hidden widgets or not.
+    #[test]
+    fn pressing_a_main_button_for_the_player_does_what_its_click_does() {
+        for hidden in [false, true] {
+            for (button, action) in [
+                (MainButton::Options, Action::Options),
+                (MainButton::Language, Action::Language),
+                (MainButton::Accessibility, Action::Accessibility),
+                (MainButton::Credits, Action::Credits),
+                (MainButton::Quit, Action::Quit),
+            ] {
+                let mut title = fresh();
+                title.set_widgets_hidden(hidden);
+                assert_eq!(title.press_main(button), Some(action));
+                assert!(matches!(title.mode, Mode::Main));
+            }
+            let mut title = fresh();
+            title.set_widgets_hidden(hidden);
+            assert_eq!(
+                title.press_main(MainButton::Multiplayer),
+                Some(Action::None)
+            );
+            assert!(matches!(
+                title.mode,
+                Mode::MultiplayerWarning { check: false }
+            ));
+            // Not on the main screen any more: nothing to press.
+            assert_eq!(title.press_main(MainButton::Quit), None);
+            let mut title = fresh();
+            title.skip_multiplayer_warning = true;
+            title.press_main(MainButton::Multiplayer);
+            assert!(matches!(title.mode, Mode::Multiplayer(_)));
+            let mut title = fresh();
+            title.press_main(MainButton::Friends);
+            assert!(matches!(
+                title.mode,
+                Mode::Multiplayer(crate::multiplayer::Screen::Friend { .. })
+            ));
+            let mut title = fresh();
+            title.press_main(MainButton::Realms);
+            assert!(matches!(title.mode, Mode::Realms(_)));
+            // No saves: Singleplayer opens Create New World, as its click does.
+            let mut title = fresh();
+            title.press_main(MainButton::Singleplayer);
+            assert!(matches!(title.mode, Mode::Create { .. }));
+        }
+        // An account that may not play online: Multiplayer and Realms are off.
+        let mut title = fresh();
+        title.allows_multiplayer = false;
+        assert_eq!(title.press_main(MainButton::Multiplayer), None);
+        assert_eq!(title.press_main(MainButton::Realms), None);
+        assert!(matches!(title.mode, Mode::Main));
+        assert_eq!(title.press_main(MainButton::Options), Some(Action::Options));
+    }
+
+    #[test]
+    fn main_button_names() {
+        for (name, button) in [
+            ("singleplayer", MainButton::Singleplayer),
+            ("multiplayer", MainButton::Multiplayer),
+            ("realms", MainButton::Realms),
+            ("friends", MainButton::Friends),
+            ("options", MainButton::Options),
+            ("language", MainButton::Language),
+            ("accessibility", MainButton::Accessibility),
+            ("credits", MainButton::Credits),
+            ("quit", MainButton::Quit),
+        ] {
+            assert_eq!(MainButton::parse(name), Some(button));
+        }
+        assert_eq!(MainButton::parse("Quit"), None);
+        assert_eq!(MainButton::parse(""), None);
+    }
 }
