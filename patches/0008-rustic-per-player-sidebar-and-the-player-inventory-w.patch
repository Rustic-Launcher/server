@@ -4398,6 +4398,69 @@ mod world_spawn_sync_tests {
             .collect()
     }
 
+    /// The helpers trait mods get for a player's inventory, their open menu, their hand and the
+    /// world spawn act on the guest the hub holds.
+    #[test]
+    #[ignore = "needs prepared resources and scratch homes/cwd"]
+    fn mod_helpers_read_the_inventory_close_any_menu_name_the_hand_and_move_the_spawn() {
+        use horizon_client::mod_api::{Hand, NativeInventoryKind};
+        let mut game = super::super::native_machines::tests::server_game();
+        game.build_registries();
+        let rx = host(&mut game);
+        let guest = &mut game.lan.as_mut().unwrap().hub.guests[0];
+        guest.selected = 4;
+        guest.inventory[4] = Some(horizon_client::items::ItemStack::new("minecraft:stick", 3));
+        // The whole inventory with the selected slot, live.
+        let inventory = game
+            .native_inventory_typed(1, NativeInventoryKind::Player)
+            .unwrap();
+        assert!(inventory.online);
+        assert_eq!(inventory.selected, 4);
+        assert_eq!(inventory.slots.len(), 41);
+        assert_eq!(inventory.slots[4].as_ref().unwrap().count, 3);
+        // Any open menu closes, the client's window with it.
+        assert!(!game.native_close_container(1), "nothing open");
+        let window = game
+            .native_open_menu(1, 3, Text::literal("Shop"), Vec::new())
+            .unwrap();
+        let _ = rx.try_iter().count();
+        assert!(game.native_close_container(1));
+        assert!(game.lan.as_ref().unwrap().hub.guests[0].menu.is_none());
+        let closed: Vec<_> = rx
+            .try_iter()
+            .flat_map(|out| match out {
+                Out::Packet(body) => vec![body],
+                Out::Packets(bodies) => bodies,
+                Out::Disconnect(_) => Vec::new(),
+            })
+            .filter_map(|body| {
+                let mut r = horizon_protocol::buf::Reader::new(&body);
+                let id = r.varint().unwrap();
+                match C::decode(id, r.rest()).ok()? {
+                    C::ContainerClose(p) => Some(p.container),
+                    _ => None,
+                }
+            })
+            .collect();
+        assert_eq!(closed, [window]);
+        assert!(!game.native_close_container(2), "no such player");
+        // The hand of a player's turn, none outside one.
+        assert_eq!(game.native_acting_hand(), None);
+        game.lan_acting_uuid = Some(1);
+        game.hand = Hand::Off;
+        assert_eq!(game.native_acting_hand(), Some(Hand::Off));
+        game.lan_acting_uuid = None;
+        // The world spawn, set as /setworldspawn sets it and told to the players.
+        assert!(game.native_set_world_spawn([100, 140, -20], [225.0, -100.0]));
+        assert_eq!(
+            game.native_world_spawn(),
+            Some(([100, 140, -20], [-135.0, -90.0]))
+        );
+        assert_eq!(spawns(&rx).len(), 1);
+        assert!(!game.native_set_world_spawn([0, 64, 0], [f32::NAN, 0.0]));
+        assert_eq!(game.native_world_spawn().unwrap().0, [100, 140, -20]);
+    }
+
