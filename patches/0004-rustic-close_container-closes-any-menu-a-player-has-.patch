--- a/crates/horizon-client/src/game/lan_actions.rs
+++ b/crates/horizon-client/src/game/lan_actions.rs
@@ -327,7 +327,7 @@ fn direction(face: i32) -> [i32; 3] {
 
 /// The windows a guest has open besides their inventory: the block or mod
 /// container, the crafting table, a station, a lectern, a merchant, a mount.
-fn guest_open_windows(host: &LanHost, conn: u32) -> Vec<i32> {
+pub(super) fn guest_open_windows(host: &LanHost, conn: u32) -> Vec<i32> {
     let mut windows: Vec<i32> = host
         .hub
         .guest(conn)
diff --git a/crates/horizon-client/src/game/native_menus.rs b/crates/horizon-client/src/game/native_menus.rs
index 651dec2bf..d70185a4e 100644
--- a/crates/horizon-client/src/game/native_menus.rs
+++ b/crates/horizon-client/src/game/native_menus.rs
@@ -227,6 +227,39 @@ impl Game<'_> {
             host.hub.close_container(conn);
         }
     }
+    /// Closes whatever menu the player has open, one of the game's own (a
+    /// chest, a furnace, a crafting table, a villager's trades, a mount's
+    /// inventory) as well as a mod's (Bukkit's `HumanEntity.closeInventory`,
+    /// vanilla's `ServerPlayer.closeContainer`): it is removed as the
+    /// player's own close removes it (the cursor stack back to the inventory,
+    /// the lid, the trade written back) and their client's window closes.
+    /// `native_player_container_close` (or `native_menu_closed` for a mod's
+    /// menu) hears it as it hears the player's own close. False when the
+    /// player is not here or has no menu open. API @API:close_container@.
+    pub(super) fn native_close_container(&mut self, uuid: u128) -> bool {
+        let Some(conn) = self.native_conn(uuid) else {
+            return false;
+        };
+        let Some(mut host) = self.lan.take() else {
+            return false;
+        };
+        let windows = super::lan_actions::guest_open_windows(&host, conn);
+        if !windows.is_empty() {
+            self.guest_close_all(&mut host, conn);
+            for container in &windows {
+                host.hub.send_to(
+                    conn,
+                    &horizon_protocol::packets::play::Clientbound::ContainerClose(
+                        horizon_protocol::packets::play::ContainerClose {
+                            container: *container,
+                        },
+                    ),
+                );
+            }
+        }
+        self.lan = Some(host);
+        !windows.is_empty()
+    }
     /// The player's 36 inventory slots (0..9 the hotbar), to show or offer
     /// them; None for a player not here, dead, or whose state is swapped in.
     pub(super) fn native_player_stacks(&self, uuid: u128) -> Option<Vec<Option<ItemStack>>> {
