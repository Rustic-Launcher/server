diff --git a/crates/horizon-client/src/game/native_client_menus.rs b/crates/horizon-client/src/game/native_client_menus.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ae894f5e06c176c8eb74a1c0664c199b46a4ba2c
--- /dev/null
+++ b/crates/horizon-client/src/game/native_client_menus.rs
@@ -0,0 +1,236 @@
+//! For a client mod that draws menus of its own over the title (a language picker, a server
+//! directory): the game's languages and choosing one as the Language screen does, the saved and
+//! recently joined servers, joining a server as the server list does and adding one to the list.
+//! API @API:client_menus@.
+use super::*;
+use horizon_client::title::{Action, Mode};
+use horizon_protocol::servers::{self, ServerEntry};
+
+/// What a mod asked for, done between frames (the helpers get a read-only game).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) enum MenuRequest {
+    Language(String),
+    Join(String),
+    Add { name: String, address: String },
+}
+
+/// Whether `address` is one the server list takes (`ServerAddress.isValidAddress`).
+fn joinable(address: &str) -> bool {
+    !address.trim().is_empty() && servers::parse_address(address.trim()).is_some()
+}
+
+/// `list` with `entry` added at its end unless an entry has its address already: whether it
+/// was added.
+fn add_unique(list: &mut Vec<ServerEntry>, entry: ServerEntry) -> bool {
+    if list.iter().any(|e| e.ip.eq_ignore_ascii_case(&entry.ip)) {
+        return false;
+    }
+    list.push(entry);
+    true
+}
+
+impl Game<'_> {
+    /// The languages the resources declare (`LanguageManager.getLanguages`), as the Language
+    /// screen lists them: `(code, name, region)`, `en_us` first then by code (`fr_fr`,
+    /// `Français`, `France`). The one in use is `lang::code`. Client only.
+    /// API @API:client_menus@.
+    pub(super) fn native_languages(&self) -> Vec<(String, String, String)> {
+        let root = self.options.resources.clone();
+        let mut all: Vec<_> = horizon_client::lang::available(&[&root])
+            .into_iter()
+            .map(|l| (l.code, l.name, l.region))
+            .collect();
+        all.sort_by_key(|(code, _, _)| (code != horizon_client::lang::DEFAULT, code.clone()));
+        all
+    }
+    /// Chooses language `code` (one of `native_languages`) as the Language screen's Done does:
+    /// it is saved in `options.txt` and the game's text reloads before the next frame. False for
+    /// a code the resources do not declare. Client only. API @API:client_menus@.
+    pub(super) fn native_set_language(&self, code: &str) -> bool {
+        if !self.native_window() || !self.native_languages().iter().any(|(c, _, _)| c == code) {
+            return false;
+        }
+        self.menu_requests
+            .borrow_mut()
+            .push(MenuRequest::Language(code.to_owned()));
+        true
+    }
+    /// The multiplayer list's servers (`servers.dat`): `(name, address, hidden)`, the shown
+    /// ones in the list's order, then the hidden ones vanilla keeps of the servers joined by
+    /// address (Direct Connection, `native_join_server`), the newest first. Client only.
+    /// API @API:client_menus@.
+    pub(super) fn native_server_list(&self) -> Vec<(String, String, bool)> {
+        let Some(saves) = self
+            .title
+            .as_ref()
+            .map(|t| t.saves.clone())
+            .or_else(|| std::env::current_dir().ok().map(|d| d.join("saves")))
+        else {
+            return Vec::new();
+        };
+        let (shown, hidden) = servers::load_all(&horizon_client::multiplayer::servers_file(&saves));
+        shown
+            .into_iter()
+            .map(|e| (e.name, e.ip, false))
+            .chain(hidden.into_iter().map(|e| (e.name, e.ip, true)))
+            .collect()
+    }
+    /// Joins the server at `address` (`host` or `host:port`) as the server list's Join Server
+    /// does, from any title screen; the address is kept among the hidden servers as Direct
+    /// Connection keeps it. The join runs before the next frame. False off the title (in a
+    /// world, or with Options over it), for an address the list would refuse, and when the
+    /// account may not play online. Client only. API @API:client_menus@.
+    pub(super) fn native_join_server(&self, address: &str) -> bool {
+        let on_title = self.screen == Screen::Playing
+            && self.title.as_ref().is_some_and(|t| t.allows_multiplayer);
+        if !on_title || !joinable(address) {
+            return false;
+        }
+        self.menu_requests
+            .borrow_mut()
+            .push(MenuRequest::Join(address.trim().to_owned()));
+        true
+    }
+    /// Adds a server named `name` at `address` at the end of the multiplayer list, as Add
+    /// Server's Done does; an open server list shows it. False for an address the list would
+    /// refuse or one it has already. Saved before the next frame. Client only.
+    /// API @API:client_menus@.
+    pub(super) fn native_add_server(&self, name: &str, address: &str) -> bool {
+        let address = address.trim();
+        if !self.native_window()
+            || !joinable(address)
+            || self
+                .native_server_list()
+                .iter()
+                .any(|(_, a, hidden)| !hidden && a.eq_ignore_ascii_case(address))
+        {
+            return false;
+        }
+        let name = if name.trim().is_empty() {
+            horizon_client::lang::get_or("selectServer.defaultName", "Minecraft Server")
+        } else {
+            name.trim().to_owned()
+        };
+        self.menu_requests.borrow_mut().push(MenuRequest::Add {
+            name,
+            address: address.to_owned(),
+        });
+        true
+    }
+    /// Runs what the helpers above queued, in order, between frames.
+    pub(super) fn run_menu_requests(&mut self, event_loop: &dyn EventLoopCtl) -> Result<()> {
+        let requests = std::mem::take(&mut *self.menu_requests.borrow_mut());
+        for request in requests {
+            match request {
+                MenuRequest::Language(code) => {
+                    if self.settings.language != code {
+                        self.settings.language = code.clone();
+                        self.settings.save(&Self::options_path());
+                        self.load_language(&code);
+                    }
+                }
+                MenuRequest::Add { name, address } => self.add_saved_server(&name, &address),
+                MenuRequest::Join(address) => {
+                    if self.title.is_none() || self.screen != Screen::Playing {
+                        continue;
+                    }
+                    self.remember_joined(&address);
+                    self.audio.play_button_click();
+                    self.title_action(
+                        event_loop,
+                        Action::Connect {
+                            address,
+                            lan: false,
+                            realm: false,
+                        },
+                    )?;
+                }
+            }
+        }
+        Ok(())
+    }
+    fn servers_path(&self) -> Option<std::path::PathBuf> {
+        let saves = self
+            .title
+            .as_ref()
+            .map(|t| t.saves.clone())
+            .or_else(|| std::env::current_dir().ok().map(|d| d.join("saves")))?;
+        Some(horizon_client::multiplayer::servers_file(&saves))
+    }
+    /// `ServerList.add(server, false)` and save; an open server list reads it again.
+    fn add_saved_server(&mut self, name: &str, address: &str) {
+        let Some(path) = self.servers_path() else {
+            return;
+        };
+        {
+            let _guard = servers::lock();
+            let (mut shown, hidden) = servers::load_all(&path);
+            if !add_unique(&mut shown, ServerEntry::new(name, address)) {
+                return;
+            }
+            if let Err(e) = servers::save_all(&path, &shown, &hidden) {
+                log::warn!("Horizon: could not save the server list: {e}");
+                return;
+            }
+        }
+        if let Some(title) = self.title.as_mut()
+            && let Mode::Multiplayer(screen @ horizon_client::multiplayer::Screen::List { .. }) =
+                &mut title.mode
+        {
+            *screen = horizon_client::multiplayer::Screen::list(&title.saves);
+        }
+    }
+    /// Direct Connection's `ServerList.add(server, true)`: the joined address among the hidden
+    /// servers, unless the list shows it.
+    fn remember_joined(&self, address: &str) {
+        let Some(path) = self.servers_path() else {
+            return;
+        };
+        let _guard = servers::lock();
+        let (shown, hidden) = servers::load_all(&path);
+        if shown.iter().any(|e| e.ip.eq_ignore_ascii_case(address)) {
+            return;
+        }
+        let name = horizon_client::lang::get_or("selectServer.defaultName", "Minecraft Server");
+        let rest: Vec<ServerEntry> = hidden
+            .into_iter()
+            .filter(|e| !e.ip.eq_ignore_ascii_case(address))
+            .collect();
+        let mut hidden = vec![ServerEntry::new(&name, address)];
+        hidden.extend(rest);
+        hidden.truncate(16);
+        if let Err(e) = servers::save_all(&path, &shown, &hidden) {
+            log::warn!("Horizon: could not save the server list: {e}");
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_addresses_the_list_takes_are_joined_or_added() {
+        assert!(joinable("play.example.org"));
+        assert!(joinable("play.example.org:25570"));
+        assert!(joinable(" 127.0.0.1 "));
+        assert!(!joinable(""));
+        assert!(!joinable("   "));
+        assert!(!joinable("bad host:99999"));
+    }
+
+    #[test]
+    fn a_server_is_added_once_by_address() {
+        let mut list = vec![ServerEntry::new("A", "a.example.org")];
+        assert!(add_unique(
+            &mut list,
+            ServerEntry::new("B", "b.example.org")
+        ));
+        assert!(!add_unique(
+            &mut list,
+            ServerEntry::new("A again", "A.example.org")
+        ));
+        assert_eq!(list.len(), 2);
+        assert_eq!(list[1].name, "B");
+    }
+}
