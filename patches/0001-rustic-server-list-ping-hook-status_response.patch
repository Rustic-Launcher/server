+/// What a status response says (`MinecraftServer.buildServerStatus`), before it is encoded.
+pub struct StatusFields {
+    /// The server's motd, as `server.properties` has it.
+    pub motd: String,
+    /// The description sent instead of `motd`, as component JSON; none sends `motd`.
+    pub description: Option<crate::server::json::Json>,
+    pub max_players: i32,
+    pub online: i32,
+    /// The players named in the list's hover: up to 12 shuffled, none when the server hides them.
+    /// An empty sample is left out.
+    pub sample: Vec<(u128, String)>,
+}
