+pub(crate) fn status_response(
+    address: std::net::SocketAddr,
+    protocol: i32,
+    motd: &str,
+    description: &mut Option<horizon_client_core::text::Text>,
+    max_players: &mut i32,
+    online: &mut i32,
+    sample: &mut Vec<(u128, String)>,
+) {
+    if let Some(hooks) = HOOKS.get() {
+        (hooks.status_response)(
+            address,
+            protocol,
+            motd,
+            description,
+            max_players,
+            online,
+            sample,
+        );
+    }
+}
