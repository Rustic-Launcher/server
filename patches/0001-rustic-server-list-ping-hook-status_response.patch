+    /// `native_status_response`'s edits reach the answer; a ping no mod changes is answered as before.
+    #[test]
+    fn a_status_edit_changes_the_answer_and_no_edit_changes_nothing() {
+        use crate::server::json::Json;
+        let config = NetConfig {
+            announce: false,
+            listen: false,
+            ..NetConfig::loopback(0, "Status".into(), 8)
+        };
+        let lan = Lan::start_with(Arc::new(data::SyncData::empty()), config).unwrap();
+        assert!(
+            lan.shared
+                .status_json()
+                .contains("\"description\":\"Status\"")
+        );
+        let edited = lan.shared.status_json_edited(PROTOCOL_VERSION, |fields| {
+            assert_eq!(fields.motd, "Status");
+            assert_eq!((fields.max_players, fields.online), (8, 0));
+            fields.description = Some(Json::Object(vec![(
+                "text".to_owned(),
+                Json::String("Welcome".to_owned()),
+            )]));
+            fields.max_players = 100;
+            fields.online = 42;
+            fields.sample.push((7, "Herobrine".to_owned()));
+        });
+        assert!(
+            edited.contains("\"description\":{\"text\":\"Welcome\"}"),
+            "{edited}"
+        );
+        assert!(edited.contains("\"max\":100,\"online\":42"), "{edited}");
+        assert!(edited.contains("\"name\":\"Herobrine\""), "{edited}");
+        assert!(lan.shared.try_admit(MEMORY_ADDRESS, 1, "Player").is_none());
+        let emptied = lan.shared.status_json_edited(PROTOCOL_VERSION, |fields| {
+            assert_eq!(fields.sample, [(1, "Player".to_owned())]);
+            fields.sample.clear();
+        });
+        assert!(!emptied.contains("\"sample\""), "{emptied}");
+        assert_eq!(
+            lan.shared.status_json_edited(PROTOCOL_VERSION, |_| {}),
+            lan.shared.status_json()
+        );
+    }
+
