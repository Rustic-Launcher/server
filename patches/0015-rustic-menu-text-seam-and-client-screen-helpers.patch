--- a/crates/horizon-client-render/src/hud.rs
+++ b/crates/horizon-client-render/src/hud.rs
@@ -2154,6 +2154,27 @@ impl HudBatch {
         color: u32,
         shadow: bool,
     ) -> f32 {
+        // A menu's text may be set by the widgets' skin (`ui::skin::menu_text`), which keeps the
+        // advances of the game's font.
+        if crate::ui::skin::menu_text_on() {
+            let resolved = text.resolved();
+            let visual = crate::bidi::visual(&resolved);
+            let advances: Vec<f32> = visual
+                .chars()
+                .map(|(c, style)| atlas.font.advance(c, style))
+                .collect();
+            let line = crate::ui::skin::TextLine {
+                text: &*visual,
+                advances: &advances,
+                x,
+                y,
+                color,
+                shadow,
+            };
+            if crate::ui::skin::text(self, atlas, &line) {
+                return advances.iter().sum();
+            }
+        }
         self.styled_text(atlas, text, x, y, color, shadow, false, None)
     }
     /// `text_styled` for text drawn in the world (`TextRenderable.render`
