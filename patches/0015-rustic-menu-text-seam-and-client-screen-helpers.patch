@@ -16,6 +22,7 @@
 //! must not panic (the game does not catch it).
 use crate::hud::{HudAtlas, HudBatch};
 use crate::text::Text;
+use std::cell::Cell;
 use std::sync::OnceLock;
 
 /// Where a centred label goes, in GUI pixels.
@@ -80,6 +87,29 @@ pub trait Skin: Send + Sync {
     ) -> bool {
         false
     }
+
+    /// Draws a menu screen's line `line` and returns true; false leaves it to the game's font.
+    /// Only asked inside [`menu_text`]. The game goes on as if its own font had drawn it: the
+    /// text that follows starts at `line.x` plus the sum of `line.advances`.
+    fn text(&self, _batch: &mut HudBatch, _atlas: &HudAtlas, _line: &TextLine<'_>) -> bool {
+        false
+    }
+}
+
+/// A line of a menu screen's text, as `HudBatch::text_styled` would draw it.
+#[derive(Clone, Copy, Debug)]
+pub struct TextLine<'a> {
+    /// The text, resolved and in visual order (right-to-left runs already reversed).
+    pub text: &'a Text,
+    /// Each character's advance in the game's font, in GUI pixels (bold included): where vanilla
+    /// puts the next one.
+    pub advances: &'a [f32],
+    /// The left of the first glyph and the top of the 9-pixel line, in GUI pixels.
+    pub x: f32,
+    pub y: f32,
+    /// The default colour (the HUD's ABGR; a style's own colour wins) and its alpha.
+    pub color: u32,
+    pub shadow: bool,
 }
 
 static SKIN: OnceLock<&'static dyn Skin> = OnceLock::new();
@@ -114,6 +144,46 @@ pub fn sprite(
     get().is_some_and(|skin| skin.sprite(batch, atlas, sprite, rect, color))
 }
 
+thread_local! {
+    /// How many [`menu_text`] scopes are open on this thread.
+    static MENU_TEXT: Cell<u32> = const { Cell::new(0) };
+}
+
+/// While the returned guard lives, the text this thread draws is a menu's: `HudBatch::text_styled`
+/// asks the skin ([`Skin::text`]) before its own font. The game opens one around the screens it
+/// draws as menus; scopes nest.
+#[must_use = "the scope ends when the guard is dropped"]
+pub fn menu_text() -> MenuText {
+    MENU_TEXT.set(MENU_TEXT.get().saturating_add(1));
+    MenuText(())
+}
+
+/// The scope [`menu_text`] opened.
+pub struct MenuText(());
+
+impl Drop for MenuText {
+    fn drop(&mut self) {
+        MENU_TEXT.set(MENU_TEXT.get().saturating_sub(1));
+    }
+}
+
+/// Whether a skin is installed and the text drawn now is a menu's.
+pub fn menu_text_on() -> bool {
+    MENU_TEXT.get() > 0 && get().is_some()
+}
+
+/// Whether the skin drew the menu line `line` (always false outside [`menu_text`]). The skin's
+/// own drawing is outside the scope, so it cannot come back here.
+pub fn text(batch: &mut HudBatch, atlas: &HudAtlas, line: &TextLine<'_>) -> bool {
+    if !menu_text_on() {
+        return false;
+    }
+    let depth = MENU_TEXT.replace(0);
+    let drawn = get().is_some_and(|skin| skin.text(batch, atlas, line));
+    MENU_TEXT.set(depth);
+    drawn
+}
+
 /// Whether the skin drew the label `text` at `at`.
 pub fn label(
     batch: &mut HudBatch,
@@ -163,6 +233,14 @@ mod tests {
             batch.fill(atlas, at.left, at.y, at.right - at.left, 9.0, 0xFF00_FF00);
             true
         }
+        fn text(&self, batch: &mut HudBatch, atlas: &HudAtlas, line: &TextLine<'_>) -> bool {
+            if line.text.plain() != "menu probe" {
+                return false;
+            }
+            let width: f32 = line.advances.iter().sum();
+            batch.fill(atlas, line.x, line.y, width, 9.0, 0xFF0F_F0F0);
+            true
+        }
     }
     static PROBE_SKIN: Probe = Probe;
 
@@ -253,4 +331,42 @@ mod tests {
         );
         assert!(other.vertices.iter().all(|v| v.color != 0xFF00_FF00));
     }
+
+    #[test]
+    fn menu_text_is_the_skins_only_inside_a_menu_scope() {
+        install(&PROBE_SKIN);
+        let atlas = atlas_with(&[]);
+        let line = Text::literal("menu probe");
+        let vanilla_width = {
+            let mut b = HudBatch::new([640, 480]);
+            b.text_styled(&atlas, &line, 0.0, 0.0, u32::MAX, false)
+        };
+        // Outside a scope (the HUD, the chat): the game's font.
+        let mut hud = HudBatch::new([640, 480]);
+        hud.text_styled(&atlas, &line, 5.0, 5.0, u32::MAX, true);
+        assert!(hud.vertices.iter().all(|v| v.color != 0xFF0F_F0F0));
+        // Inside: the skin's, and the advance the game's font would have taken.
+        let mut menu = HudBatch::new([640, 480]);
+        let advance = {
+            let _scope = menu_text();
+            assert!(menu_text_on());
+            {
+                let _nested = menu_text();
+            }
+            assert!(menu_text_on());
+            menu.text_styled(&atlas, &line, 5.0, 5.0, u32::MAX, true)
+        };
+        assert!(!menu_text_on());
+        assert_eq!(menu.vertices.len(), 6);
+        assert!(menu.vertices.iter().all(|v| v.color == 0xFF0F_F0F0));
+        assert!((advance - vanilla_width).abs() < 1e-3);
+        // A line the skin leaves is the game's, in a scope too.
+        let mut other = HudBatch::new([640, 480]);
+        {
+            let _scope = menu_text();
+            other.text_styled(&atlas, &Text::literal("Options"), 0.0, 0.0, u32::MAX, false);
+        }
+        assert!(!other.vertices.is_empty());
+        assert!(other.vertices.iter().all(|v| v.color != 0xFF0F_F0F0));
+    }
 }
