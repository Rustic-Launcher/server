diff --git a/crates/horizon-client/src/game/native_client_screens.rs b/crates/horizon-client/src/game/native_client_screens.rs
new file mode 100644
index 0000000000000000000000000000000000000000..89f00dee55191932d4c45f5187c0fb00327179dd
--- /dev/null
+++ b/crates/horizon-client/src/game/native_client_screens.rs
@@ -0,0 +1,391 @@
+//! For a client mod that draws the title's lists and dialogs itself (cards, forms, panels of its
+//! own over the game's screens): the world list and the server list as data, the world icons,
+//! choosing a row as a click on it does, a press anywhere on the open screen as the mouse would
+//! give it (so a mod's own buttons can press the screen's own: Join, Edit, Delete...).
+//! API @API:client_screens@.
+use super::*;
+use horizon_client::multiplayer::{Ping, Screen as Servers};
+use horizon_client::text::Text;
+use horizon_client::title::Mode;
+use std::sync::Arc;
+use winit::{
+    dpi::PhysicalPosition,
+    event::{DeviceId, ElementState, MouseButton, WindowEvent},
+};
+
+/// One world of the world list (`SelectWorldScreen`), as the list knows it.
+#[derive(Clone, Debug, PartialEq)]
+pub struct NativeWorldEntry {
+    /// Its folder in `saves`, which identifies it.
+    pub folder: String,
+    pub name: String,
+    /// `GameType`: 0 survival, 1 creative, 2 adventure, 3 spectator.
+    pub game_mode: i32,
+    pub hardcore: bool,
+    /// Commands (cheats) allowed.
+    pub commands: bool,
+    /// When it was last played, in milliseconds since the Unix epoch.
+    pub last_played: i64,
+    /// The game version that saved it (`Version.Name`), empty when unknown.
+    pub version: String,
+    /// Another running game has it open (`LevelSummary.isLocked`).
+    pub locked: bool,
+    /// Its `level.dat` did not read: opening it offers recovery.
+    pub corrupted: bool,
+    /// The saved version's name when another series saved it (not playable here).
+    pub incompatible: Option<String>,
+    pub experimental: bool,
+    /// Opening it upgrades its files, or a newer version saved it: a backup is offered first.
+    pub needs_backup: bool,
+    /// The list's selected row.
+    pub selected: bool,
+}
+
+/// How a server of the server list answered its ping.
+#[derive(Clone, Debug, PartialEq)]
+pub enum NativeServerStatus {
+    /// Asked, no answer yet.
+    Pinging,
+    /// It answered with this game's protocol.
+    Online {
+        ping_ms: u32,
+        /// Online and max players, when the status says.
+        players: Option<(i64, i64)>,
+        version: String,
+    },
+    /// It answered with another protocol (`ServerData.State.INCOMPATIBLE`).
+    Incompatible {
+        players: Option<(i64, i64)>,
+        /// The server's version, as the list shows it in red.
+        version: Text,
+    },
+    /// It could not be reached; the reason.
+    Unreachable(String),
+    /// A world opened to the local network (no ping).
+    Lan,
+}
+
+/// One row of the server list (`ServerSelectionList`): a saved server or a LAN world.
+#[derive(Clone, Debug)]
+pub struct NativeServerEntry {
+    pub name: String,
+    pub address: String,
+    /// A world announced on the local network (listed after the saved servers).
+    pub lan: bool,
+    /// The message of the day, styled; empty while pinging or unreachable.
+    pub motd: Text,
+    pub status: NativeServerStatus,
+    /// The players the status names (its sample), as the list's tooltip shows them.
+    pub player_list: Vec<Text>,
+    /// The server's icon, 64x64 RGBA, when it has one.
+    pub icon: Option<Arc<Vec<u8>>>,
+    /// Server Resource Packs: Some(true) enabled, Some(false) disabled, None prompt.
+    pub packs: Option<bool>,
+    /// The list's selected row.
+    pub selected: bool,
+}
+
+/// What a mod asked for, done between frames (the helpers get a read-only game).
+#[derive(Clone, Debug, PartialEq)]
+pub(super) enum ScreenRequest {
+    Select(usize),
+    Press(f32, f32),
+}
+
+/// Milliseconds since the Unix epoch.
+fn millis(t: std::time::SystemTime) -> i64 {
+    match t.duration_since(std::time::UNIX_EPOCH) {
+        Ok(d) => i64::try_from(d.as_millis()).unwrap_or(i64::MAX),
+        Err(e) => -i64::try_from(e.duration().as_millis()).unwrap_or(i64::MAX),
+    }
+}
+
+/// A world folder's plain name (no separator, no `..`): the only ones whose icon is read.
+fn plain_folder(folder: &str) -> bool {
+    !folder.is_empty()
+        && folder != "."
+        && folder != ".."
+        && !folder.contains(['/', '\\', ':'])
+        && !folder.contains("..")
+}
+
+/// What a saved server's ping says, as the list shows it.
+fn status_of(ping: Option<&Ping>) -> (NativeServerStatus, Text, Vec<Text>) {
+    match ping {
+        None | Some(Ping::Pinging) => (NativeServerStatus::Pinging, Text::empty(), Vec::new()),
+        Some(Ping::Ok {
+            motd,
+            players,
+            player_list,
+            ms,
+            version,
+        }) => (
+            NativeServerStatus::Online {
+                ping_ms: u32::try_from(*ms).unwrap_or(u32::MAX),
+                players: *players,
+                version: version.clone(),
+            },
+            motd.clone(),
+            player_list.clone(),
+        ),
+        Some(Ping::Incompatible {
+            motd,
+            players,
+            player_list,
+            version,
+        }) => (
+            NativeServerStatus::Incompatible {
+                players: *players,
+                version: version.clone(),
+            },
+            motd.clone(),
+            player_list.clone(),
+        ),
+        Some(Ping::Failed(reason)) => (
+            NativeServerStatus::Unreachable(reason.clone()),
+            Text::empty(),
+            Vec::new(),
+        ),
+    }
+}
+
+impl Game<'_> {
+    /// The world list's worlds as the open world list (`world_select`) has them, in its order
+    /// (the newest played first), whatever its search shows; empty on any other screen. Client
+    /// only. API @API:client_screens@.
+    pub(super) fn native_world_entries(&self) -> Vec<NativeWorldEntry> {
+        let Some(Mode::Select { worlds, selected }) = self.title.as_ref().map(|t| &t.mode) else {
+            return Vec::new();
+        };
+        worlds
+            .iter()
+            .enumerate()
+            .map(|(i, w)| NativeWorldEntry {
+                folder: w.folder.clone(),
+                name: w.name.clone(),
+                game_mode: w.game_mode,
+                hardcore: w.hardcore,
+                commands: w.commands,
+                last_played: millis(w.modified),
+                version: w.version.clone(),
+                locked: w.locked,
+                corrupted: w.corrupted,
+                incompatible: w.incompatible.clone(),
+                experimental: w.experimental,
+                needs_backup: w.file_fixing || w.downgrade,
+                selected: *selected == Some(i),
+            })
+            .collect()
+    }
+    /// The icon of world `folder` (its `icon.png`, as saved: a PNG), when it has one. Only a
+    /// folder's plain name is read, never a path. Client only. API @API:client_screens@.
+    pub(super) fn native_world_icon(&self, folder: &str) -> Option<Vec<u8>> {
+        if !plain_folder(folder) {
+            return None;
+        }
+        let path = self.title.as_ref()?.saves.join(folder).join("icon.png");
+        let size = std::fs::metadata(&path).ok()?.len();
+        // An icon is a 64x64 PNG; anything far larger is not one.
+        if size > 1 << 20 {
+            return None;
+        }
+        std::fs::read(path).ok()
+    }
+    /// The open server list's rows (`multiplayer`): the saved servers in the list's order with
+    /// their ping, then the worlds found on the local network; empty on any other screen.
+    /// Client only. API @API:client_screens@.
+    pub(super) fn native_server_entries(&self) -> Vec<NativeServerEntry> {
+        let Some(Mode::Multiplayer(Servers::List {
+            servers,
+            selected,
+            pings,
+            icons,
+            lan,
+            ..
+        })) = self.title.as_ref().map(|t| &t.mode)
+        else {
+            return Vec::new();
+        };
+        let pings = pings.lock().unwrap_or_else(|e| e.into_inner());
+        let icons = icons.lock().unwrap_or_else(|e| e.into_inner());
+        let mut out: Vec<NativeServerEntry> = servers
+            .iter()
+            .enumerate()
+            .map(|(i, s)| {
+                let (status, motd, player_list) = status_of(pings.get(&s.ip));
+                NativeServerEntry {
+                    name: s.name.clone(),
+                    address: s.ip.clone(),
+                    lan: false,
+                    motd,
+                    status,
+                    player_list,
+                    icon: icons.get(&s.ip).cloned(),
+                    packs: s.accept_textures,
+                    selected: *selected == Some(i),
+                }
+            })
+            .collect();
+        let saved = servers.len();
+        out.extend(
+            lan.games()
+                .into_iter()
+                .enumerate()
+                .map(|(k, g)| NativeServerEntry {
+                    name: horizon_client::lang::get_or("lanServer.title", "Minecraft World"),
+                    address: g.address,
+                    lan: true,
+                    motd: Text::literal(g.motd),
+                    status: NativeServerStatus::Lan,
+                    player_list: Vec::new(),
+                    icon: None,
+                    packs: None,
+                    selected: *selected == Some(saved + k),
+                }),
+        );
+        out
+    }
+    /// Selects row `index` of the title's open list as a click on it does (not a double click):
+    /// a world of [`Self::native_world_entries`] on the world list, a row of
+    /// [`Self::native_server_entries`] on the server list. Done before the next frame, before
+    /// any press asked after it. False on another screen or for a row the list does not have.
+    /// Client only. API @API:client_screens@.
+    pub(super) fn native_title_select(&self, index: usize) -> bool {
+        let rows = match self.title.as_ref().map(|t| &t.mode) {
+            Some(Mode::Select { worlds, .. }) => worlds.len(),
+            Some(Mode::Multiplayer(Servers::List { servers, lan, .. })) => {
+                servers.len() + lan.games().len()
+            }
+            _ => return false,
+        };
+        if index >= rows {
+            return false;
+        }
+        self.screen_requests
+            .borrow_mut()
+            .push(ScreenRequest::Select(index));
+        true
+    }
+    /// Presses the open screen at GUI point `(x, y)` with the left button, as the mouse would
+    /// (the pointer goes back where it was): a mod that draws a screen's buttons its own way
+    /// presses the screen's own with it. Done before the next frame; the screens' mouse hooks
+    /// do not hear it (it is not the mouse). False with no window or off the GUI. Client only.
+    /// API @API:client_screens@.
+    pub(super) fn native_press_at(&self, x: f32, y: f32) -> bool {
+        if !self.native_window() || !x.is_finite() || !y.is_finite() || x < 0.0 || y < 0.0 {
+            return false;
+        }
+        self.screen_requests
+            .borrow_mut()
+            .push(ScreenRequest::Press(x, y));
+        true
+    }
+    /// Runs what the helpers above queued, in order, between frames.
+    pub(super) fn run_screen_requests(&mut self, event_loop: &dyn EventLoopCtl) {
+        let requests = std::mem::take(&mut *self.screen_requests.borrow_mut());
+        for request in requests {
+            match request {
+                ScreenRequest::Select(index) => self.select_title_row(index),
+                ScreenRequest::Press(x, y) => self.press_screen(event_loop, x, y),
+            }
+        }
+    }
+    fn select_title_row(&mut self, index: usize) {
+        let Some(title) = self.title.as_mut() else {
+            return;
+        };
+        match &mut title.mode {
+            Mode::Select { worlds, selected } if index < worlds.len() => *selected = Some(index),
+            Mode::Multiplayer(Servers::List {
+                servers,
+                selected,
+                lan,
+                ..
+            }) if index < servers.len() + lan.games().len() => *selected = Some(index),
+            _ => {}
+        }
+    }
+    /// A left click at `(x, y)`, the pointer put back after it; marked as made up, so the
+    /// native mods' mouse hooks skip it (as the pad's clicks).
+    fn press_screen(&mut self, event_loop: &dyn EventLoopCtl, x: f32, y: f32) {
+        let Some(id) = self.window.as_ref().map(|w| w.id()) else {
+            return;
+        };
+        let Some(scale) = self
+            .renderer
+            .as_ref()
+            .map(|r| horizon_client::hud::HudBatch::new([r.config.width, r.config.height]).scale)
+        else {
+            return;
+        };
+        let back = self.cursor;
+        let at =
+            |(x, y): (f32, f32)| PhysicalPosition::new(f64::from(x * scale), f64::from(y * scale));
+        let device_id = DeviceId::dummy();
+        let was = std::mem::replace(&mut self.pad.menu.synthetic, true);
+        let mut events = vec![WindowEvent::CursorMoved {
+            device_id,
+            position: at((x, y)),
+        }];
+        for state in [ElementState::Pressed, ElementState::Released] {
+            events.push(WindowEvent::MouseInput {
+                device_id,
+                state,
+                button: MouseButton::Left,
+            });
+        }
+        events.push(WindowEvent::CursorMoved {
+            device_id,
+            position: at(back),
+        });
+        for event in events {
+            self.handle_window_event(event_loop, id, event, super::input_trace::InputOrigin::Game);
+        }
+        self.pad.menu.synthetic = was;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_plain_world_folders_are_read() {
+        assert!(plain_folder("New World"));
+        assert!(plain_folder("Monde (2)"));
+        assert!(!plain_folder(""));
+        assert!(!plain_folder(".."));
+        assert!(!plain_folder("../other"));
+        assert!(!plain_folder("a/b"));
+        assert!(!plain_folder("a\\b"));
+        assert!(!plain_folder("C:"));
+    }
+
+    #[test]
+    fn pings_read_as_the_list_shows_them() {
+        let (s, motd, _) = status_of(None);
+        assert_eq!(s, NativeServerStatus::Pinging);
+        assert!(motd.plain().is_empty());
+        let ok = Ping::Ok {
+            motd: Text::literal("Hello"),
+            players: Some((3, 20)),
+            player_list: vec![Text::literal("Steve")],
+            ms: 42,
+            version: "26.3".into(),
+        };
+        let (s, motd, list) = status_of(Some(&ok));
+        assert_eq!(
+            s,
+            NativeServerStatus::Online {
+                ping_ms: 42,
+                players: Some((3, 20)),
+                version: "26.3".into()
+            }
+        );
+        assert_eq!(motd.plain(), "Hello");
+        assert_eq!(list.len(), 1);
+        let (s, _, _) = status_of(Some(&Ping::Failed("refused".into())));
+        assert_eq!(s, NativeServerStatus::Unreachable("refused".into()));
+        assert_eq!(millis(std::time::UNIX_EPOCH), 0);
+    }
+}
