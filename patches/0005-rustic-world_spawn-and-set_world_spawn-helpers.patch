diff --git a/crates/horizon-client/src/game/native_level_world.rs b/crates/horizon-client/src/game/native_level_world.rs
index d9eb520a8..83ddd1aae 100644
--- a/crates/horizon-client/src/game/native_level_world.rs
+++ b/crates/horizon-client/src/game/native_level_world.rs
@@ -60,6 +60,29 @@ impl Game<'_> {
     pub(super) fn native_level_is_thundering(&self, level: LevelRef) -> Option<bool> {
         Some(weather_flags(self.native_level_weather(level)?).1)
     }
+    /// The world spawn (level.dat's respawn data, Bukkit's `World.getSpawnLocation`): the block
+    /// position players without a respawn point of their own appear at, and its yaw and pitch.
+    /// None where no world runs here (a client of a server). API @API:world_spawn@.
+    pub(super) fn native_world_spawn(&self) -> Option<([i32; 3], [f32; 2])> {
+        if self.remote.is_some() {
+            return None;
+        }
+        let pos = self.world_spawn_position().map(|v| v.floor() as i32);
+        Some((pos, self.level.world_spawn_angle))
+    }
+    /// Sets the world spawn as `/setworldspawn <pos> <yaw> <pitch>` does (Bukkit's
+    /// `World.setSpawnLocation`), from any server hook: the yaw is wrapped to -180..180 and the
+    /// pitch clamped to -90..90, every player hears the new spawn, `native_spawn_change` is
+    /// heard, and a player whose respawn point was the old world spawn respawns at the new one.
+    /// False where no world runs here or for an angle that is not finite. API @API:world_spawn@.
+    pub(super) fn native_set_world_spawn(&mut self, pos: [i32; 3], angle: [f32; 2]) -> bool {
+        if self.native_world_spawn().is_none() || !angle.iter().all(|a| a.is_finite()) {
+            return false;
+        }
+        let yaw = super::commands::wrap_degrees(angle[0]);
+        self.set_world_spawn(pos, [yaw, angle[1].clamp(-90.0, 90.0)]);
+        true
+    }
     /// Sets the time of day, as `/time set <ticks>` does on the overworld clock: mods hear
