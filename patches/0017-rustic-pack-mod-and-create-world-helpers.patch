+    /// A page drawn over the screen moves packs by id as the icon's arrows do, an incompatible
+    /// pack asks first, and a restore puts back the selection the screen opened with.
+    #[test]
+    fn packs_move_by_id_and_a_restore_puts_the_opening_selection_back() {
+        let atlas =
+            crate::hud::HudAtlas::build(std::path::Path::new("/nonexistent/horizon-test-assets"))
+                .unwrap();
+        let m = Measure(&atlas.font);
+        let mut old = pack("file/Old", None);
+        old.compat = Compat::TooOld;
+        let packs = vec![pack("file/A", None), pack("file/B", None), old];
+        let mut screen = PackScreen::new(&m, tr("resourcePack.title"), 480, 320, false, packs, &[]);
+        let selected = |s: &PackScreen| -> Vec<String> {
+            s.model.selected.iter().map(|p| p.id.clone()).collect()
+        };
+        assert!(screen.act("file/A", PackAct::Select));
+        assert!(screen.act("file/B", PackAct::Select));
+        assert_eq!(selected(&screen), ["file/B", "file/A"]);
+        assert!(screen.act("file/A", PackAct::Up));
+        assert_eq!(selected(&screen), ["file/A", "file/B"]);
+        assert!(!screen.act("file/A", PackAct::Up), "already on top");
+        assert_eq!(screen.can("file/B"), (false, true, true, false));
+        // Incompatible: the confirmation opens, nothing moves yet.
+        assert!(screen.act("file/Old", PackAct::Select));
+        assert!(screen.confirming());
+        assert!(
+            !screen.act("file/B", PackAct::Unselect),
+            "not under a confirmation"
+        );
+        assert!(screen.changed);
+        screen.restore();
+        assert!(!screen.confirming() && !screen.changed);
+        assert!(selected(&screen).is_empty());
+    }
