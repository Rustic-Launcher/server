diff --git a/crates/horizon-client/src/game/native_client_options.rs b/crates/horizon-client/src/game/native_client_options.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0f6d4fb59fddc0d1026bcdc2d0914f41e262c98b
--- /dev/null
+++ b/crates/horizon-client/src/game/native_client_options.rs
@@ -0,0 +1,502 @@
+//! For a client mod that draws the options' pack screen, the mod browser and Create World its own
+//! way (pages of its own over the game's screens): what they show, as data, and what their
+//! buttons do, done as their own buttons do it (selections committed and resources reloaded on
+//! leaving, installs checked as the browser's, the world created by the screen itself).
+//! API @API:client_options@.
+use super::*;
+use horizon_client::mod_browser::ModBrowser;
+use horizon_client::options_ui::{Event as OptionsEvent, Page};
+use horizon_client::pack_screen::{Compat, PackAct, Source as PackSource};
+use horizon_client::text::Text;
+use horizon_client::title::Mode;
+use std::sync::Arc;
+
+/// One pack of the open pack screen (Resource Packs, or Create World's Data Packs).
+#[derive(Clone, Debug)]
+pub struct NativePack {
+    /// `file/<name>`, `vanilla`, `server/…`: what options.txt names it by.
+    pub id: String,
+    pub title: Text,
+    pub description: Text,
+    /// Its `pack.png`, RGBA, `icon_size` pixels square; None draws the game's unknown pack.
+    pub icon: Option<Arc<[u8]>>,
+    pub icon_size: u32,
+    pub compat: Compat,
+    pub source: PackSource,
+    /// Always selected (the vanilla pack).
+    pub required: bool,
+    /// Stays where it is in its list (a server's pack on top).
+    pub fixed: bool,
+    pub can_select: bool,
+    pub can_unselect: bool,
+    pub can_move_up: bool,
+    pub can_move_down: bool,
+    /// It has Polytone options (resource packs only).
+    pub has_options: bool,
+}
+
+/// The open pack screen as its two lists show it.
+#[derive(Clone, Debug)]
+pub struct NativePacks {
+    /// Create World's Data Packs rather than Resource Packs.
+    pub data: bool,
+    /// The selected packs, top (applied last, over the others) first.
+    pub selected: Vec<NativePack>,
+    /// The others, in the screen's order.
+    pub available: Vec<NativePack>,
+    /// The screen's confirmation for an incompatible pack is open (drawn by the game).
+    pub confirming: bool,
+    /// The selection changed since the screen opened: leaving applies it.
+    pub changed: bool,
+}
+
+/// One installed mod, as the Mods page lists it.
+#[derive(Clone, Debug, PartialEq)]
+pub struct NativeInstalledMod {
+    pub id: String,
+    pub title: String,
+    pub description: String,
+    pub on: bool,
+    /// Built into the game (a native mod).
+    pub native: bool,
+    /// Why it is not running, when it failed.
+    pub problem: Option<String>,
+    /// Loaded with `--dev-mod`: always on.
+    pub dev: bool,
+}
+
+/// The installed mods and the mod browser (Options > Mods > Browse mods).
+#[derive(Clone, Debug)]
+pub struct NativeMods {
+    pub installed: Vec<NativeInstalledMod>,
+    /// The registry's content mods this game installs, the install running and the last
+    /// install's outcome, as Browse Mods shows them (filled once Browse Mods was opened).
+    pub browser: ModBrowser,
+}
+
+/// What a mod's page over the options presses.
+#[derive(Clone, Debug, PartialEq)]
+pub enum NativeOptionsAct {
+    /// On the pack screen: a pack's card's arrows (an incompatible pack asks first).
+    Pack(String, PackAct),
+    /// On the pack screen: back to the selection it opened with (then `Leave` is a Cancel).
+    PackRestore,
+    /// On the pack screen: Open Pack Folder.
+    PackFolder,
+    /// Done, Back or Escape on the open page: leaving the pack screen applies its selection.
+    Leave,
+    /// Browse Mods' Install or Update of the registry's project `id`.
+    InstallMod(String),
+    /// The Mods page's switch of installed mod `id`.
+    ToggleMod(String),
+    /// The registry's page of project `id` on the website (through the game's link screen).
+    ModPage(String),
+    /// Reads the registry's index again (as Browse Mods does when it opens).
+    BrowseMods,
+    /// The mods folder in the file manager.
+    ModFolder,
+}
+
+/// Create World's choices, whatever tab shows them.
+#[derive(Clone, Debug, PartialEq)]
+pub struct NativeCreateWorld {
+    pub name: String,
+    pub seed: String,
+    /// 0 Survival, 1 Hardcore, 2 Creative.
+    pub game_mode: u8,
+    /// `peaceful`, `easy`, `normal` or `hard` (`options.difficulty.<name>`).
+    pub difficulty: &'static str,
+    /// Allow Commands, as it reads now (it follows the game mode until changed).
+    pub commands: bool,
+    /// The world type's name key (`generator.minecraft.normal`...).
+    pub world_type: &'static str,
+    /// The world type has a Customize screen (flat, single biome).
+    pub customizable: bool,
+    pub structures: bool,
+    pub bonus_chest: bool,
+    /// The data packs chosen so far.
+    pub data_packs: usize,
+    /// One of its own screens is over it (Game Rules, Experiments...) or the world is being
+    /// prepared: its buttons take no press.
+    pub covered: bool,
+}
+
+/// What a mod's Create World form does.
+#[derive(Clone, Debug, PartialEq)]
+pub enum NativeCreateAct {
+    Name(String),
+    Seed(String),
+    /// The keyboard to the World Name (0) or Seed (1) field, or neither (2): the game's own
+    /// field then takes typing, paste and the cursor keys.
+    Focus(u8),
+    /// A press on the screen's button `id` (`step` -1 steps a cycle button back): 20 Game Mode,
+    /// 23 Difficulty, 24 Allow Commands, 25 World Type, 26 Customize, 27 Generate Structures,
+    /// 28 Bonus Chest, 29 Game Rules, 30 Experiments, 31 Data Packs, 21 Create New World,
+    /// 22 Cancel.
+    Press(u8, i32),
+}
+
+/// What a mod asked for, done between frames.
+#[derive(Clone, Debug, PartialEq)]
+pub(super) enum OptionsRequest {
+    Options(NativeOptionsAct),
+    Create(NativeCreateAct),
+}
+
+/// An options page's id for mods: stable names, one per page.
+fn page_id(page: Page) -> &'static str {
+    match page {
+        Page::Main => "main",
+        Page::Video => "video",
+        Page::Sound => "sound",
+        Page::Controls => "controls",
+        Page::KeyBinds => "key_binds",
+        Page::Mouse => "mouse",
+        Page::Chat => "chat",
+        Page::Accessibility => "accessibility",
+        Page::Language => "language",
+        Page::Font => "font",
+        Page::Packs => "packs",
+        Page::Mods => "mods",
+        Page::ModBrowser => "mod_browser",
+        Page::ModProject => "mod_project",
+        Page::NativeMod(_) => "native_mod",
+        Page::Added(_) => "added",
+        Page::ShaderPacks => "shader_packs",
+        Page::ShaderOptions => "shader_options",
+        Page::PackOptions => "pack_options",
+        Page::Graphics => "graphics",
+        Page::GraphicsAdvanced => "graphics_advanced",
+        Page::GraphicsHdr => "graphics_hdr",
+        Page::HdrCalibration => "hdr_calibration",
+        Page::Controller => "controller",
+        Page::PadBinds => "pad_binds",
+        Page::Extras => "extras",
+        Page::Pvp => "pvp",
+        Page::Credits => "credits",
+        Page::Horizon => "horizon",
+        Page::Studio => "studio",
+        Page::Agent => "agent",
+        Page::Skin => "skin",
+        Page::Online => "online",
+        Page::SplitProfiles => "split_profiles",
+        Page::SplitSetup => "split_setup",
+        Page::Music => "music",
+    }
+}
+
+impl Game<'_> {
+    /// The options are the open screen.
+    fn options_on_top(&self) -> bool {
+        self.screen == Screen::Options && self.screen_hooks_open()
+    }
+    /// The open options page (screen id `options`): `packs` (Resource Packs), `data_packs`
+    /// (Create World's Data Packs), `mods`, `mod_browser` (Browse Mods), `mod_project`, `main`,
+    /// `video`, `sound`... one stable name per page; None when the options aren't open. On the
+    /// settings layout the pages of one settings screen share its id (`main`). Client only.
+    /// API @API:client_options@.
+    pub(super) fn native_options_page(&self) -> Option<&'static str> {
+        if !self.options_on_top() {
+            return None;
+        }
+        let ui = &self.ui.options;
+        Some(if ui.data_packs_open() {
+            "data_packs"
+        } else {
+            page_id(ui.page())
+        })
+    }
+    /// The open pack screen's packs (Resource Packs or Create World's Data Packs), as its two
+    /// lists hold them; None on any other page and before its first frame. Client only.
+    /// API @API:client_options@.
+    pub(super) fn native_options_packs(&self) -> Option<NativePacks> {
+        if !self.options_on_top() || self.ui.options.page() != Page::Packs {
+            return None;
+        }
+        let screen = self.ui.options.pack_screen.as_ref()?;
+        let pack = |id: &str| -> Option<NativePack> {
+            let info = screen.packs.iter().find(|p| p.id == id)?;
+            let (can_select, can_unselect, can_move_up, can_move_down) = screen.can(id);
+            Some(NativePack {
+                id: info.id.clone(),
+                title: info.title.clone(),
+                description: info.description.clone(),
+                icon: info.icon.clone(),
+                icon_size: horizon_client::hud::PACK_ICON_SIZE,
+                compat: info.compat,
+                source: info.source,
+                required: info.required,
+                fixed: info.fixed,
+                can_select,
+                can_unselect,
+                can_move_up,
+                can_move_down,
+                has_options: screen.with_options.contains(&info.id),
+            })
+        };
+        Some(NativePacks {
+            data: self.ui.options.data_packs_open(),
+            selected: screen
+                .model
+                .selected
+                .iter()
+                .filter_map(|p| pack(&p.id))
+                .collect(),
+            available: screen
+                .model
+                .unselected
+                .iter()
+                .filter_map(|p| pack(&p.id))
+                .collect(),
+            confirming: screen.confirming(),
+            changed: screen.changed,
+        })
+    }
+    /// The installed mods and Browse Mods' state, whatever options page is open; None when the
+    /// options aren't. Client only. API @API:client_options@.
+    pub(super) fn native_options_mods(&self) -> Option<NativeMods> {
+        if !self.options_on_top() {
+            return None;
+        }
+        let mods = &self.settings.mods;
+        Some(NativeMods {
+            installed: mods
+                .installed
+                .iter()
+                .enumerate()
+                .map(|(i, m)| NativeInstalledMod {
+                    id: m.id.clone(),
+                    title: m.title.clone(),
+                    description: m.description.clone(),
+                    on: mods.is_on(i),
+                    native: m.native.is_some(),
+                    problem: m.problem.clone(),
+                    dev: m.dev,
+                })
+                .collect(),
+            browser: self.ui.options.mod_browser.clone(),
+        })
+    }
+    /// Does `act` on the open options page as its own button does, before the next frame (a
+    /// later act of the same event after it). False when the options aren't open or `act` is
+    /// for another page (a pack act off the pack screen). Client only. API @API:client_options@.
+    pub(super) fn native_options_act(&self, act: NativeOptionsAct) -> bool {
+        if !self.options_on_top() {
+            return false;
+        }
+        let packs = self.ui.options.page() == Page::Packs;
+        let ok = match &act {
+            NativeOptionsAct::Pack(..)
+            | NativeOptionsAct::PackRestore
+            | NativeOptionsAct::PackFolder => packs,
+            _ => true,
+        };
+        if ok {
+            self.options_requests
+                .borrow_mut()
+                .push(OptionsRequest::Options(act));
+        }
+        ok
+    }
+    /// Create World's choices (screen id `world_create`); None on any other screen. Client
+    /// only. API @API:client_options@.
+    pub(super) fn native_create_world(&self) -> Option<NativeCreateWorld> {
+        if self.screen != Screen::Playing || !self.screen_hooks_open() {
+            return None;
+        }
+        let title = self.title.as_ref()?;
+        let Mode::Create {
+            name,
+            seed,
+            creative,
+            options,
+            ..
+        } = &title.mode
+        else {
+            return None;
+        };
+        use horizon_client::save::WorldPreset;
+        Some(NativeCreateWorld {
+            name: name.clone(),
+            seed: seed.clone(),
+            game_mode: match (*creative, options.hardcore) {
+                (_, true) => 1,
+                (true, false) => 2,
+                (false, false) => 0,
+            },
+            difficulty: horizon_client::title::DIFFICULTIES[options.difficulty()],
+            commands: options.commands(*creative),
+            world_type: options.world_type.label(),
+            customizable: matches!(
+                options.world_type,
+                WorldPreset::Flat | WorldPreset::SingleBiomeSurface
+            ),
+            structures: options.structures,
+            bonus_chest: options.bonus_chest(),
+            data_packs: options.data_packs.len(),
+            covered: title.create_covered(),
+        })
+    }
+    /// Does `act` on Create World as its own field or button does, before the next frame
+    /// (presses as [`horizon_client::title::Title::press_create`] takes them). False on another
+    /// screen. Client only. API @API:client_options@.
+    pub(super) fn native_create_world_act(&self, act: NativeCreateAct) -> bool {
+        if self.native_create_world().is_none() {
+            return false;
+        }
+        self.options_requests
+            .borrow_mut()
+            .push(OptionsRequest::Create(act));
+        true
+    }
+    /// The clicks a controller (its A button over a widget) or the keyboard's focus makes up reach
+    /// the screens' mouse hooks too (`on`), at the point they press, for a mod that draws widgets
+    /// of its own over a screen: a controller then presses them, not the screen underneath. Off
+    /// by default (a made-up click is not the mouse); a mod's own `native_press_at` never reaches
+    /// them. Holds for this window until changed. Client only. API @API:client_options@.
+    pub(super) fn native_pad_clicks_to_hooks(&self, on: bool) {
+        self.pad_clicks_to_hooks.set(on);
+    }
+    /// Runs what the helpers above queued, in order, between frames.
+    pub(super) fn run_options_requests(&mut self, event_loop: &dyn EventLoopCtl) -> Result<()> {
+        let requests = std::mem::take(&mut *self.options_requests.borrow_mut());
+        for request in requests {
+            match request {
+                OptionsRequest::Options(act) => {
+                    if self.screen != Screen::Options {
+                        continue;
+                    }
+                    let events = self.options_events(act);
+                    if !events.is_empty() {
+                        self.handle_option_events(events)?;
+                    }
+                }
+                OptionsRequest::Create(act) => {
+                    let Some(title) = self.title.as_mut() else {
+                        continue;
+                    };
+                    match act {
+                        NativeCreateAct::Name(text) => {
+                            title.set_create_text(false, &text);
+                        }
+                        NativeCreateAct::Seed(text) => {
+                            title.set_create_text(true, &text);
+                        }
+                        NativeCreateAct::Focus(field) => {
+                            title.set_create_focus(field);
+                        }
+                        NativeCreateAct::Press(id, step) => {
+                            if let Some(action) = title.press_create(id, step) {
+                                self.audio.play_button_click();
+                                self.title_action(event_loop, action)?;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+    /// The options' events `act` makes, as the press of its button would.
+    fn options_events(&mut self, act: NativeOptionsAct) -> Vec<OptionsEvent> {
+        let ui = &mut self.ui.options;
+        let s = &mut self.settings;
+        match act {
+            NativeOptionsAct::Pack(id, pack_act) => {
+                if ui.page() == Page::Packs
+                    && let Some(screen) = &mut ui.pack_screen
+                {
+                    screen.act(&id, pack_act);
+                }
+                Vec::new()
+            }
+            NativeOptionsAct::PackRestore => {
+                if ui.page() == Page::Packs
+                    && let Some(screen) = &mut ui.pack_screen
+                {
+                    screen.restore();
+                }
+                Vec::new()
+            }
+            NativeOptionsAct::PackFolder if ui.page() == Page::Packs => {
+                vec![ui.pack_folder_event()]
+            }
+            NativeOptionsAct::PackFolder => Vec::new(),
+            NativeOptionsAct::Leave => {
+                let mut events = vec![OptionsEvent::ButtonClick];
+                events.extend(ui.back(s));
+                events
+            }
+            NativeOptionsAct::InstallMod(id) => vec![OptionsEvent::InstallMod(id)],
+            NativeOptionsAct::ToggleMod(id) => {
+                match s.mods.installed.iter().position(|m| m.id == id && !m.dev) {
+                    Some(i) => {
+                        s.mods.toggle(i);
+                        vec![OptionsEvent::Changed]
+                    }
+                    None => Vec::new(),
+                }
+            }
+            NativeOptionsAct::ModPage(id) => ui
+                .mod_browser
+                .listing(&id)
+                .map(|l| vec![OptionsEvent::OpenModPage(l.page.clone())])
+                .unwrap_or_default(),
+            NativeOptionsAct::BrowseMods => vec![OptionsEvent::BrowseMods],
+            NativeOptionsAct::ModFolder => vec![OptionsEvent::OpenModFolder],
+        }
+    }
+}
+
