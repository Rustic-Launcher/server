+    /// Create World has a screen of its own open over it (Game Rules, Experiments, the
+    /// experiments' confirmation) or prepares the world: its own widgets don't take presses.
+    pub fn create_covered(&self) -> bool {
+        matches!(self.mode, Mode::Create { .. })
+            && (self.rules.borrow().is_some()
+                || self.experiments.borrow().is_some()
+                || self.confirm_experiments.borrow().is_some()
+                || self.preparing)
