+    /// Presses Create World's button `id` (whatever tab shows it) as a click on it does, for a
+    /// page drawn over the screen in another layout: `step` -1 steps a cycle button back (the
+    /// mouse wheel's way). The action for the game to run, as after a click; None on another
+    /// screen, under one of its own screens (`create_covered`), for an id it doesn't have and
+    /// for a button that is off (Difficulty in Hardcore...). Ids: 20 Game Mode, 23 Difficulty,
+    /// 24 Allow Commands, 25 World Type, 26 Customize, 27 Generate Structures, 28 Bonus Chest,
+    /// 29 Game Rules, 30 Experiments, 31 Data Packs, 21 Create New World, 22 Cancel.
+    pub fn press_create(&mut self, id: u8, step: i32) -> Option<Action> {
+        if self.create_covered() {
+            return None;
+        }
+        let Mode::Create {
+            creative, options, ..
+        } = &mut self.mode
+        else {
+            return None;
+        };
+        let tab = match id {
+            20 | 23 | 24 => 0,
+            25..=28 => 1,
+            29..=31 => 2,
+            21 | 22 => options.tab,
+            _ => return None,
+        };
+        let mut shown = options.clone();
+        shown.tab = tab;
+        // Laid out at any size: only the ids and whether they are on matter.
+        let on = create_world::buttons(480.0, 270.0, *creative, &shown)
+            .iter()
+            .any(|b| b.id == id && b.enabled);
+        if !on {
+            return None;
+        }
+        if step < 0 && matches!(id, 20 | 23 | 25) {
+            options.cycle(id, creative, step);
+            return Some(Action::None);
+        }
+        Some(self.click_action(0.0, 0.0, (480.0, 270.0), Some(id)))
+    }
