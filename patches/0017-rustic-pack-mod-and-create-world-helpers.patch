+    /// What a press on a pack's card does, for a screen drawn by someone else over this one (a
+    /// client mod's own pack page): the same as the arrows on its icon. Selecting an incompatible
+    /// pack opens its confirmation first, as the icon does. False when it can't be done (the
+    /// pack isn't in that list, is required or fixed, a confirmation is open).
+    pub fn act(&mut self, id: &str, act: PackAct) -> bool {
+        if self.confirm.is_some() {
+            return false;
+        }
+        let side = usize::from(act != PackAct::Select);
+        let Some(index) = self.model_index(side, id) else {
+            return false;
+        };
+        let (sel, unsel, up, down) = self.flags(side, id);
+        let s = side == 1;
+        match act {
+            PackAct::Select if sel => {
+                if self
+                    .info(id)
+                    .is_some_and(|p| p.compat != Compat::Compatible)
+                {
+                    self.open_confirm(id);
+                    return true;
+                }
+                self.model.activate(s, index, true);
+            }
+            PackAct::Unselect if unsel => {
+                self.model.activate(s, index, false);
+            }
+            PackAct::Up if up => {
+                self.model.move_by(s, index, true);
+            }
+            PackAct::Down if down => {
+                self.model.move_by(s, index, false);
+            }
+            _ => return false,
+        }
+        self.changed = true;
+        self.populate(Some(id));
+        true
+    }
+    /// Back to the selection the screen opened with (a Cancel): leaving then changes nothing.
+    pub fn restore(&mut self) {
+        self.confirm = None;
+        self.model = SelectionModel::new(
+            self.packs.iter().map(PackInfo::selectable).collect(),
+            &self.opened_with,
+        );
+        self.changed = false;
+        self.populate(None);
+    }
+    /// What can be done to pack `id` now: (select, unselect, up, down).
+    pub fn can(&self, id: &str) -> (bool, bool, bool, bool) {
+        let side = usize::from(self.model.selected.iter().any(|p| p.id == id));
+        self.flags(side, id)
+    }
 
